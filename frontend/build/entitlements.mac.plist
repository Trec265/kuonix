<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron (V8) and the bundled JVM both generate machine code at runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- JavaCPP extracts OpenCV/OpenBLAS dylibs from the jar into ~/.javacpp/cache
       and loads them; they are not signed with this app's Team ID. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Ollama Cloud (AI assistant) and the loopback backend connection. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
