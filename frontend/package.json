{
  "name": "kuonix",
  "productName": "Kuonix",
  "version": "1.0.0",
  "description": "Batch image correction and grouping tool with limited editing capablities",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "stage": "node scripts/stage.mjs --verify",
    "dist:win": "node scripts/dist.mjs win",
    "dist:mac": "node scripts/dist.mjs mac",
    "dist:linux": "node scripts/dist.mjs linux"
  },
  "keywords": [
    "image",
    "batch",
    "correction",
    "electron",
    "photo",
    "color"
  ],
  "author": {
    "name": "Cleanwell Mwalwanda",
    "email": "cleanwellmwalwanda@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@vitest/coverage-v8": "^4.1.8",
    "canvas": "^3.2.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "sudo-prompt": "^9.2.1",
    "tree-kill": "^1.2.2"
  }
}
